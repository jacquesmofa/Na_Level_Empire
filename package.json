{
  "name": "na-level-empire",
  "private": true,
  "version": "1.0.0",
  "description": "Website for Na Level Empire Media (NLEM), Toronto",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "validate": "node scripts/validate-content.ts",
    "build": "vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr --emptyOutDir && node scripts/prerender.ts",
    "preview": "vite preview",
    "lint": "eslint src --report-unused-disable-directives --max-warnings 0",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json",
    "test": "node --test \"scripts/**/*.test.ts\" \"api/**/*.test.ts\"",
    "check": "npm run lint && npm run typecheck && npm run validate && npm run cms:check && npm test",
    "cms:config": "node scripts/cms-config.ts write",
    "cms:check": "node scripts/cms-config.ts check"
  },
  "dependencies": {
    "@fontsource/bebas-neue": "5.3.0",
    "@fontsource/dm-sans": "5.3.0",
    "@fontsource/syne": "5.3.0",
    "react": "^19.1.2",
    "react-dom": "^19.1.2",
    "react-router-dom": "^7.6.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.1",
    "@sveltia/cms": "0.248.0",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.1",
    "ajv": "^8.20.0",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.30.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "jiti": "^2.6.1",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.35.1",
    "vite": "^8.0.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  }
}
